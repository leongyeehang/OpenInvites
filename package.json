{
  "name": "openinvites",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "docker compose --profile dev up -d --wait && NEXT_TELEMETRY_DISABLED=1 next dev",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "NEXT_TELEMETRY_DISABLED=1 next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:s3": "vitest run --config vitest.s3.config.ts",
    "test:e2e": "docker compose --profile test up -d --build --wait && playwright test",
    "perf": "docker compose --profile test up -d --build --wait && playwright test --config playwright.perf.config.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@bradenmacdonald/s3-lite-client": "^1.0.0",
    "better-auth": "^1.7.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.47.0",
    "markdown-it": "^15.0.2",
    "next": "16.3.5",
    "next-intl": "^4.14.5",
    "nodemailer": "^10.0.10",
    "postgres": "^3.4.9",
    "qrcode-svg": "^1.1.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "sharp": "^0.35.4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@formatjs/icu-messageformat-parser": "^3.5.20",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode-svg": "^1.1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "lighthouse": "^13.5.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  }
}
