# OpenInvites instance settings. Copy this file to .env next to compose.yaml and fill in the
# values marked "Required". Everything else is optional: a commented-out line holds the default
# the instance uses when the variable is absent or empty (nothing, where there is none), and the
# comment above it may give an example. docs/operator/configuration.md explains each one at more
# length.
#
# The app reads these when its container starts: after a change, run `docker compose up -d`
# (a plain restart keeps the old values). A value it cannot use keeps it from starting, with
# the reason in `docker compose logs app`.
#
# Quoting: put a value that holds a $ or quotes in single quotes, which keep it exactly as written.
# A value over several lines goes in double quotes.

# ---------------------------------------------------------------------------------------------
# The Compose file itself
# ---------------------------------------------------------------------------------------------

# Required. Password of the database's own user. Letters and digits only, as it goes into the
# app's DATABASE_URL, which compose.yaml builds from it. Read only when the database is first
# created. Make one with: openssl rand -hex 24
POSTGRES_PASSWORD=

# The image to run. Pin a release (1.2.3), a minor line (1.2) or a major line (1) instead of
# latest to choose when you move on. The same image is on Docker Hub as leongyeehang/openinvites.
# OPENINVITES_IMAGE=ghcr.io/leongyeehang/openinvites:latest

# Starts the bundled Caddy for automatic HTTPS (Caddyfile). Remove this line to use a reverse
# proxy of your own, pointed at http://127.0.0.1:3000.
COMPOSE_PROFILES=caddy

# The port on this machine's loopback where the app listens for the reverse proxy.
# APP_PORT=3000

# ---------------------------------------------------------------------------------------------
# The instance
# ---------------------------------------------------------------------------------------------

# Required. The instance's public address, exactly as a browser shows it, with no trailing
# slash, such as https://invites.example.org. Links in emails start with it, uploads are refused
# from any other origin, and the bundled Caddy gets its certificate for this name.
BASE_URL=

# Required. Signs sessions and the links in emails. Keep it secret; changing it signs every host
# out. At least 32 characters. Make one with: openssl rand -hex 32
AUTH_SECRET=

# Shown to hosts when they need you, such as to reset a password on an instance without mail,
# and on the privacy policy and terms pages. Default: none.
OPERATOR_CONTACT_EMAIL=

# Your own account, to take the instance back if someone else created its first account (the
# first account is the operator). Use an address that is not public, not the one above, and
# remove this once your account is the operator. Default: none.
# OPERATOR_EMAIL=

# ---------------------------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------------------------

# The SMTP server for outgoing mail: smtp://user:password@mail.example.org:587 (STARTTLS) or
# smtps://user:password@mail.example.org:465. Percent-encode special characters in the user and
# password (@ is %40). Default: none, which means no mail: hosts are not asked to verify their
# email, and a forgotten password is reset by you with the command in docs/operator/upgrade-backup.md.
# SMTP_URL=

# The sender of outgoing mail, such as: OpenInvites <no-reply@invites.example.org>
# Required when SMTP_URL is set.
# MAIL_FROM=

# ---------------------------------------------------------------------------------------------
# Sign in with Google and GitHub
# ---------------------------------------------------------------------------------------------

# Each button appears only when both its values are set. Redirect URLs to register with the
# provider: BASE_URL/api/auth/callback/google and BASE_URL/api/auth/callback/github.
# Default: none, so no button.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ---------------------------------------------------------------------------------------------
# Uploaded pictures
# ---------------------------------------------------------------------------------------------

# The largest picture a host may upload, in megabytes (decimals allowed).
# MAX_UPLOAD_MB=10

# Where pictures are kept: local (the uploads volume) or s3.
# STORAGE_BACKEND=local

# Local storage's directory inside the container. compose.yaml mounts the uploads volume at
# /app/uploads, which is what the default means; leave it.
# UPLOADS_DIR=uploads

# S3-compatible storage, when STORAGE_BACKEND=s3. Endpoint, bucket and both keys are required
# then. The endpoint is the provider's, such as https://s3.eu-central-1.amazonaws.com; requests
# are path-style (endpoint/bucket/key). The bucket can stay private.
# S3_ENDPOINT=
# S3_REGION=us-east-1
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------------------------
# Rate limits (always on)
# ---------------------------------------------------------------------------------------------

# How many reverse proxies are in front of the app, each adding to X-Forwarded-For. 1 is the
# bundled Caddy (or your own proxy); 2 is a CDN and Caddy. 0 believes no address, so every
# visitor shares one allowance.
# TRUSTED_PROXY_HOPS=1

# Each limit is a number of requests per window from one client (an IPv4 address, or an IPv6
# /64), written count/window with s, m or h.
# Every request under an event link: pages, preview cards, calendar files, known links or not.
# RATE_LIMIT_EVENT_PAGE=120/1m
# Sending or removing an RSVP.
# RATE_LIMIT_RSVP=60/10m
# Uploading a picture.
# RATE_LIMIT_UPLOAD=20/10m
# Signing up, and opening a host invitation link.
# RATE_LIMIT_SIGN_UP=10/1h
# Signing in, and anything else that checks a password; starting a Google or GitHub sign-in.
# RATE_LIMIT_SIGN_IN=10/15m
# Asking for a password reset link, and setting the new password.
# RATE_LIMIT_PASSWORD_RESET=10/1h
# Every request that sends an email, including host invitations you have emailed.
# RATE_LIMIT_MAIL=10/1h
# Posting a comment on an event page.
# RATE_LIMIT_COMMENT=30/10m

# ---------------------------------------------------------------------------------------------
# Privacy policy and terms of use
# ---------------------------------------------------------------------------------------------

# Your own Markdown for /privacy and /terms: either the path of a file mounted into the
# container, such as /legal/privacy.md (read on every request, so edits show at once), or the
# Markdown itself, in double quotes. Not both for one page. Default: a placeholder that says the
# page is not written yet.
# PRIVACY_POLICY_FILE=
# PRIVACY_POLICY_MARKDOWN=
# TERMS_FILE=
# TERMS_MARKDOWN=

# ---------------------------------------------------------------------------------------------
# Analytics
# ---------------------------------------------------------------------------------------------

# HTML put into the head of every page as written, in single quotes, such as your own analytics
# tool's script tag:
#   ANALYTICS_SNIPPET='<script defer src="https://analytics.example.org/script.js" data-website-id="..."></script>'
# Default: none, and then nothing at all is added. OpenInvites itself never sends anything to the
# project or anyone else.
# ANALYTICS_SNIPPET=
