# Defaults for local development against the Compose `dev` profile.
# Override in .env.development.local (ignored by git).
DATABASE_URL=postgres://openinvites:openinvites@localhost:5432/openinvites
BASE_URL=http://localhost:3000
# Development only. A real instance sets a long random value.
AUTH_SECRET=development-only-secret-change-me-0123456789abcdef
# The `dev` profile runs Mailpit; read what the app sent at http://localhost:8025.
# Leave SMTP_URL empty to develop the "instance without mail" behaviour instead.
SMTP_URL=smtp://127.0.0.1:1025
MAIL_FROM=OpenInvites <no-reply@localhost>
OPERATOR_CONTACT_EMAIL=operator@localhost
# Always let in to sign up, and made the operator once its email is verified (Mailpit has the
# link). The browser tests sign in as this account (e2e/operator.setup.ts), so it is the same as
# the Compose `test` profile's.
OPERATOR_EMAIL=operator@openinvites.test
# Rate limits as low as the Compose `test` profile's, so the browser tests behave the same against
# `next dev` (e2e/rate-limits.spec.ts). Without a reverse proxy in front, Next.js fills in a
# missing X-Forwarded-For with the address the request came from, so a browser on this machine is
# counted as 127.0.0.1 (or ::1).
RATE_LIMIT_EVENT_PAGE=40/1m
RATE_LIMIT_RSVP=5/1m
RATE_LIMIT_UPLOAD=3/1m
RATE_LIMIT_SIGN_UP=5/1m
RATE_LIMIT_SIGN_IN=5/1m
RATE_LIMIT_PASSWORD_RESET=5/1m
RATE_LIMIT_MAIL=5/1m
